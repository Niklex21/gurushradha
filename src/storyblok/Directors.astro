---
import type { DirectorsStoryblok } from "@/component-types";
const { blok } = Astro.props as { blok: DirectorsStoryblok };
---
{blok.directors?.map((director) => (
    <div class="flex items-start gap-4 py-4 border-b border-border">
      <div class="flex-1">
        <h2 class="text-3xl font-bold text-left ">{director?.Name}</h2>
        <h3 class="mt-3 text-left">{director?.Description}</h3>
      </div>

      <img
        class="w-[300px] h-[450px] object-cover rounded"
        src={director?.Picture?.filename}
        alt={director?.Picture?.alt}
      />
    </div>
 ))}
<div class="mt-5">
 <b> Board of Directors </b>:
 Niharika Mohanty (Executive Director),
 Anjana Mohanty (Treasurer),
 Maya Devalcheruvu (Secretary),
 Ritu Bhatnagar,
 Kanika Mitra Bhattacharya,
 Subarna Bhattacharya,
 Anushmita Dash,
 Namrata Mohanty,
 Shravani Mukherjee,
 Smitanjali Indira Priyadarshini,
 Ragini Vecham
 </div>
