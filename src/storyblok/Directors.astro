---
import { renderRichText } from "@storyblok/astro";
import type { EditableDirectors as DirectorsStoryblok } from "@/lib/site-content";
const { blok } = Astro.props as { blok: DirectorsStoryblok };
const board = blok.board ? renderRichText(blok.board) : "";
---

{
  blok.directors?.map((director) => (
    <div class="flex items-start gap-4 py-4 border-b border-border">
      <div class="flex-1">
        <h2 class="text-3xl font-bold text-left ">{director?.Name}</h2>
        <h3 class="mt-3 text-left">{director?.Description}</h3>
      </div>

      <img
        class="w-[300px] h-[450px] object-cover rounded"
        src={director?.Picture?.filename}
        alt={director?.Picture?.alt}
      />
    </div>
  ))
}
<div class="mt-5" set:html={board} />
