---
import { storyblokEditable, type SbBlokData } from "@storyblok/astro";

interface Milestone extends SbBlokData {
  component: "timeline_milestone";
  year: string;
  label: string;
}

interface Props {
  blok: SbBlokData & {
    heading: string;
    caption: string;
    milestones?: Milestone[];
  };
}

const { blok } = Astro.props;
---

<div
  {...storyblokEditable(blok)}
  class="py-8 px-4 bg-orange-50 mt-8 w-full max-w-[58rem] self-center"
>
  <h2 class="text-2xl font-bold text-center text-orange-700 mb-8">
    {blok.heading}
  </h2>
  <div
    class="relative flex flex-col items-center md:flex-row md:justify-between max-w-4xl mx-auto gap-4 mt-16"
  >
    <div
      class="absolute md:top-[38px] top-0 w-1 h-full bg-orange-300 md:w-full md:h-1"
    >
    </div>
    {
      blok.milestones
        ?.filter((item) => item.component === "timeline_milestone")
        .map((item) => (
          <div
            {...storyblokEditable(item)}
            class="relative flex flex-col items-center gap-2"
          >
            <p class="text-sm font-semibold text-orange-800">{item.year}</p>
            <div class="w-6 h-6 bg-orange-500 rounded-full border-2 border-orange-700 z-10" />
            <p class="mt-1 text-center text-sm text-orange-600 line-clamp-2 p-2 rounded-xl bg-orange-100">
              {item.label}
            </p>
          </div>
        ))
    }
  </div>
  <div class="mt-16 text-center text-orange-700 font-medium">
    {blok.caption}
  </div>
</div>
