---
import Layout from "@/layouts/Layout.astro";
import { useStoryblokGet } from "@/utils";
import StoryblokComponent from "@storyblok/astro/StoryblokComponent.astro";
import type { SbBlokData } from "@storyblok/astro";

const { data } = await useStoryblokGet("cdn/stories/our-story");
const sections = (data.story.content.sections ?? []) as SbBlokData[];
---

<Layout title={data.story.name}>
  <div class="our-story flex flex-col gap-8 w-full">
    {sections.map((blok) => <StoryblokComponent blok={blok} />)}
  </div>
</Layout>

<style>
  .our-story > :global(.rich-content:first-child h2) {
    @apply text-3xl font-bold text-red-main font-serif sm:mx-auto sm:w-fit;
  }

  .our-story > :global(.rich-content:last-child) {
    @apply text-left;
  }

  .our-story > :global(.rich-content:last-child h3) {
    @apply font-bold text-xl sm:text-2xl mt-8;
  }

  .our-story > :global(.rich-content:last-child h3:first-child) {
    @apply text-2xl md:text-3xl;
  }

  .our-story > :global(.rich-content:last-child ul) {
    @apply list-disc pl-8 mt-8 gap-0;
  }
</style>
